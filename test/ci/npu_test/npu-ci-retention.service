[Unit]
Description=Retain NPU CI evidence and reclaim confirmed archived runs

[Service]
Type=oneshot
User=ci-npu
Group=ci-npu
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /srv/npu-ci/runtime/evidence-v1/lifecycle.py --policy /srv/npu-ci/runtime/evidence-v1/policy.json gc --mode apply
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/npu-ci/jobs/slot0 /srv/npu-ci/evidence/fork-slot0 /srv/npu-ci/state/fork-slot0 /srv/actions-runner/tokenspeed-fork-npu-01/_diag
TimeoutStartSec=300
