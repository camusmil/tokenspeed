{
  "schema_version": 1,
  "watch_paths": [
    "tokenspeed-kernel-npu/**",
    "tokenspeed-kernel/python/**",
    "python/pyproject.toml",
    "test/ci/npu_test/**",
    ".github/workflows/pr-test-ascendnpu-arm.yml",
    "test/ci_system/*ascend*",
    "test/ci_system/npu/**",
    "tokenspeed-kernel/test/npu/ops/**",
    ".github/workflows/run-ci-task-matrix-npu.yml"
  ],
  "execution": {
    "phases": [
      "accuracy",
      "performance"
    ],
    "fail_fast": true
  },
  "performance_policy": {
    "verdict": "not_evaluated"
  },
  "operators": [
    {
      "name": "scatter",
      "script": "tokenspeed-kernel/test/npu/ops/test_scatter.py"
    },
    {
      "name": "virtual_slots_to_local",
      "script": "tokenspeed-kernel/test/npu/ops/test_virtual_slots_to_local.py"
    }
  ],
  "name": "ut-tokenspeed-kernel-npu",
  "type": "ut",
  "workflow_stage": "operator",
  "triggers": [
    "push",
    "pull_request",
    "workflow_dispatch"
  ],
  "resources": {
    "architecture": "aarch64",
    "device_ids": [
      0
    ],
    "exclusive_host": true
  },
  "timeouts": {
    "lock_wait_seconds": 600,
    "phase_execution_seconds": 1800,
    "job_minutes": 90
  },
  "runner": "ascend-npu-ops-test",
  "report": {
    "artifact_retention_days": 7,
    "artifact_max_bytes": 1073741824,
    "upload_attempts": 3
  },
  "cleanup": {
    "delete_unarchived": false,
    "pending_warning_seconds": 86400
  }
}
