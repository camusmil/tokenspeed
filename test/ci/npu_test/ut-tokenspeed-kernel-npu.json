{
  "schema_version": 1,
  "watch_paths": [
    "tokenspeed-kernel-npu/**",
    "tokenspeed-kernel/python/**",
    "python/pyproject.toml",
    "test/ci/npu_test/**",
    ".github/workflows/pr-test-ascendnpu-arm.yml",
    "test/ci_system/*ascend*",
    "test/ci_system/npu/**"
  ],
  "execution": {
    "phases": [
      "accuracy",
      "performance"
    ],
    "fail_fast": true
  },
  "performance_policy": {
    "verdict": "not_evaluated"
  },
  "operators": [
    {
      "name": "scatter",
      "script": "test/ci/npu_test/test_case/test_scatter.py"
    },
    {
      "name": "virtual_slots_to_local",
      "script": "test/ci/npu_test/test_case/test_virtual_slots_to_local.py"
    }
  ],
  "name": "ut-tokenspeed-kernel-npu",
  "type": "operator",
  "workflow_stage": "operator",
  "triggers": [
    "push",
    "pull_request",
    "workflow_dispatch"
  ],
  "resources": {
    "architecture": "aarch64",
    "device_ids": [
      0
    ],
    "exclusive_host": true
  },
  "timeouts": {
    "lock_wait_seconds": 600,
    "phase_execution_seconds": 1800,
    "job_minutes": 90
  }
}
